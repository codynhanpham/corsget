# Normalize text files to LF in the repository.
* text=auto eol=lf

# Keep Windows shell scripts in their native line-ending format.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Always use LF for Unix shell scripts.
*.sh text eol=lf

# Common binary files must not be treated as text.
*.7z binary
*.gif binary
*.ico binary
*.jpeg binary
*.jpg binary
*.pdf binary
*.png binary
*.wasm binary
*.webp binary
*.zip binary